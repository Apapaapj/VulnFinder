# ====================================
# WEBSITE VULNERABILITY SCANNER CONFIG
# ====================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:3000
API_TIMEOUT=30000

# Email/Alert Service (Choose one)
# Option 1: RESEND (Email alerts)
RESEND_API_KEY=re_xxxxxxxxxxxxx
ALERT_EMAIL=alzzxdancowwnoface@gmail.com

# Option 2: DISCORD WEBHOOK (Instant notifications)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxx/xxxxx

# Security
ENCRYPTION_KEY=your-secret-encryption-key-min-32-chars
JWT_SECRET=your-jwt-secret-key
API_KEY=your-api-key-for-external-access

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_HONEYPOT_MAX=5

# Honeypot Configuration
HONEYPOT_AUTO_BAN_DURATION=86400000
HONEYPOT_ALERT_ENABLED=true
HONEYPOT_LOG_IPS=true

# Database (if using)
DATABASE_URL=file:./prisma/dev.db
DATABASE_TYPE=sqlite

# Statistics
STATS_RETENTION_DAYS=90
STATS_UPDATE_INTERVAL=300000

# Feature Flags
FEATURE_PDF_EXPORT=true
FEATURE_JSON_EXPORT=true
FEATURE_SHARE_LINKS=true
FEATURE_STATISTICS=true
FEATURE_HONEYPOT=true
FEATURE_EMAIL_ALERTS=true

# Scanning Configuration
MAX_CONCURRENT_SCANS=5
SCAN_TIMEOUT_SECONDS=60
DEEP_SCAN_ENABLED=true

# Security
CORS_ORIGIN=http://localhost:3000
TRUST_PROXY=true
SESSION_SECRET=your-session-secret

# Deployment
NODE_ENV=development
VERCEL_ENV=development

# Optional: Self-hosted settings
SELF_HOSTED_URL=https://yourdomain.com
SELF_HOSTED_ENABLED=false
